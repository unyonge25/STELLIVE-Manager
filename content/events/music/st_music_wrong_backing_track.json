        "fail": {
          "text": "캐릭터와 노래 둘 다 놓쳤다.",
          "next": "end_cringe"
        }
      }
    },
    "medley_stage": {
      "type": "check",
      "text": "원곡에서 트로트로 넘어가는 순간, 분위기를 단번에 바꿔야 한다.",
      "check": {
        "stat": "Vc",
        "difficulty": 74,
        "traitBonus": {
          "cover": 10,
          "rhythm": 5
