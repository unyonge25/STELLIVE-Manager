        "fail": {
          "text": "가사를 따라가다 박자를 완전히 놓쳤다. 웃음보다 정적이 길었다.",
          "next": "end_cringe"
        }
      }
    },
    "improv_stage": {
      "type": "check",
      "text": "모르는 가사 자리에 방송 이야기와 시청자 닉네임을 즉석으로 끼워 넣는다.",
      "check": {
        "stat": "Bs",
        "difficulty": 72,
        "traitBonus": {
          "spontaneous": 10,
          "chatter": 5,
          "highTension": 5
