      }
    },
    "extend": {
      "type": "check",
      "text": "제작진과의 통화. 사정을 설명하고 하루를 얻어 내야 한다.",
      "check": {
        "stat": "Bs",
        "difficulty": 68,
        "traitBonus": {
          "brain": 10,
          "calm": 5
        }
      },
      "outcomes": {
        "success": {
          "text": "제작진이 흔쾌히 이틀을 내줬다. {member}는 그날 밤 일찍 잠들었다.",
          "next": "end_rested"
        },
        "partial": {
          "text": "반나절만 연장됐다. 결국 키를 낮춰 오늘 녹음하기로 했다.",
          "next": "lowered"
        },
        "fail": {
          "text": "연장은 어렵다는 답이 돌아왔다. 결국 원키로 오늘 밤 끝내야 한다.",
          "effects": {
            "hp": -3
          },
          "next": "push_first"
