    },
    "lowered": {
      "type": "check",
      "text": "한 키 낮춘 반주가 흐른다. 익숙하지 않은 높이에서 곡의 감정을 다시 찾아야 한다.",
      "check": {
        "stat": "Vc",
        "difficulty": 70,
        "traitBonus": {
          "calm": 10,
          "cover": 5
        }
      },
      "outcomes": {
        "success": {
          "text": "낮춘 키가 오히려 곡에 새로운 색을 입혔다.",
          "next": "end_new_color"
        },
        "partial": {
          "text": "무난하게 끝났지만 원래 곡의 시원함은 줄었다.",
          "next": "end_mixed"
        },
        "fail": {
          "text": "낮은 키에서 감정이 잘 실리지 않았다.",
          "next": "end_flat"
