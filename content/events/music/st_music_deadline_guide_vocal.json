        "stat": "Vc",
        "difficulty": 80,
        "traitBonus": {
          "perfectionist": 10,
          "diligent": 5
        }
      },
      "outcomes": {
        "success": {
          "text": "고음이 걸렸다. 아직 한 번 더 남았다.",
          "next": "push_second"
        },
        "partial": {
          "text": "음은 냈지만 끝이 갈라졌다. 다음 후렴에서 만회해야 한다.",
          "effects": {
            "hp": -2
          },
          "next": "push_second"
