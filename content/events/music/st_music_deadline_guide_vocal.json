    "end_paid_off": {
      "type": "end",
      "result": "success",
      "text": "무리한 도박이었지만 결과물은 확실했다. 다만 다음 날 {member}는 하루 종일 말을 아꼈다.",
      "effects": {
        "fans": 120,
