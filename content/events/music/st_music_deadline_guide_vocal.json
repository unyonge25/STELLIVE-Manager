    "end_strained": {
      "type": "end",
      "result": "fail",
      "text": "녹음은 중단됐다. 며칠은 목을 쉬게 해야 한다. 무리하지 말라는 팬들의 메시지가 쏟아졌다.",
      "effects": {
        "fans": 10,
        "hp": -4,
        "memberFlags": {
