    "end_cut_corners": {
      "type": "end",
      "result": "partial",
      "text": "정시에 끝낸 덕에 마무리는 깔끔했고 '편하게 봤다'는 후기도 있었다. 다만 예고했던 코너가 빠져 '그 코너 기다렸는데'라는 아쉬움도 적지 않았다.",
      "effects": {
        "fans": 100,
        "relationship": 3,
        "hp": -5
      }
