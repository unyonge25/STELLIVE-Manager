      "text": "연장전까지 다 보여 줬다. 시청자들은 만족했지만 출연자들은 다음 날 목이 쉬었다.",
      "effects": {
        "fans": 130,
        "relationship": 3,
        "hp": -5
      }
    },
    "end_overrun": {
      "type": "end",
