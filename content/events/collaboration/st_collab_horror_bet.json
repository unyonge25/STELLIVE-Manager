    "tiebreak": {
      "type": "choice",
      "text": "판정이 애매하다. 채팅창은 재경기를 외친다.",
      "choices": [
        {
          "text": "깔끔하게 졌다고 인정한다",
          "story": "{member}가 먼저 '내가 졌다'고 손을 들었다. 채팅창에 박수가 쏟아졌다.",
          "effects": {
            "relationship": 2
          },
          "next": "end_graceful"
