    "game": {
      "type": "check",
      "text": "팬 대표들과 미니 게임 한 판. 봐주면 티가 나고, 이기면 원성이 쏟아진다.",
      "check": {
        "stat": "Ga",
        "difficulty": 70,
        "traitBonus": {
          "spontaneous": 5,
          "competitive": 5,
          "highTension": 5
