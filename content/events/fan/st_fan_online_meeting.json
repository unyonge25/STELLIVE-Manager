    "end_touching": {
      "type": "end",
      "result": "success",
      "text": "떨리는 목소리로 전한 고맙다는 말이 오래 남았다. 팬미팅 다시보기에는 '울면서 봤다'는 댓글이 가득하다.",
      "effects": {
        "fans": 140,
        "fame": 1,
        "hp": 5
      }
